# Frontend build-time configuration.
#
# Leave UNSET for local development: paths stay relative and Vite proxies
# /api to the local backend.
#
# Set on Vercel to your deployed backend's origin (no trailing slash):
#   VITE_API_BASE=https://qr-registration-api.onrender.com
#
# Vite inlines this at build time, so changing it on Vercel needs a redeploy.
VITE_API_BASE=
